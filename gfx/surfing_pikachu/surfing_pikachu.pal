; Surfing Pikachu palettes (CGB)
; Ported from Yellow's PAL_PIKACHUS_BEACH / PAL_PIKACHUS_BEACH_TITLE
;
; FORMAT: entries are in COLOUR-INDEX order (index 0..3), since the DMG
; shade indirection (DmgToCgb*) has been dropped for this GBC-only hack.
; Colour index 0 = white (sky), 1 = yellow (Pikachu), 2 = blue (water),
; 3 = black (outlines) -- see Yellow's colour semantics below.
;
; Yellow's colour semantics (colour index -> meaning):
;     0 = white  (sky)
;     1 = yellow (Pikachu, beach sand)
;     2 = blue   (water)
;     3 = black  (outlines)
;
; ============================================================
; BG palettes (5 palettes, loaded into wBGPals1 slots 0-4)
; ============================================================
;
; BG 0: sky + logo -- sky, 1st logo colour, 2nd logo colour, black
;       colour-index order: sky, logo1, logo2, black
	RGB 15,20,31, 31,26,00, 31,04,00, 00,00,00

; BG 1: sand -- white, light sand, dark sand, black
;       colour-index order: white, light-sand, dark-sand, black
	RGB 31,31,31, 29,26,07, 23,15,11, 00,00,00

; BG 2: water -- white, light sand, water, black
;       colour-index order: white, light-sand, water, black
	RGB 31,31,31, 29,26,07, 11,23,31, 00,00,00

; BG 3: palm tree -- white, light sand, trunk, leaves
;       colour-index order: white, light-sand, trunk, leaves
	RGB 31,31,31, 29,26,07, 23,15,11, 04,22,10

; BG 4: border colour -- white, light green, dark green, black
;       colour-index order: white, light green, dark green, black
	RGB 31,31,31, 09,19,05, 05,14,10, 00,00,00

; ============================================================
; OBJ palettes (loaded into wOBPals1, 5 palettes used)
; ============================================================
;
; OBJ 0: Pikachu sprite + surfboard
;        colour-index order: white, yellow, red, black
	RGB 31,31,31, 31,27,07, 27,06,00, 00,00,00

; OBJ 1: Text "Oh no..", "Start", "Goal", splashes and water spray
;        colour-index order: white, light blue, green, black
	RGB 31,31,31, 11,23,31, 04,22,10, 00,00,00

; OBJ 2: Clouds
;        colour-index order: white, very light blue, light blue, black
	RGB 31,31,31, 25,26,31, 21,24,31, 00,00,00

; OBJ 3: Surf Icon (progress marker), plus points
;        colour-index order: white, yellow, blue, black
	RGB 31,31,31, 31,31,00, 11,23,31, 03,03,03

; OBJ 4: Splashes, water spray
;        colour-index order: white, white, blue, black
	RGB 31,31,31, 31,31,31, 11,23,31, 00,00,00